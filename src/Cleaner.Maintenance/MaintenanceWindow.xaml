<Window x:Class="Cleaner.Maintenance.MaintenanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows maintenance · Storage Cleaner" Width="900" Height="730" MinWidth="700" MinHeight="570" Background="#111C30" Foreground="#ECF3FF" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="WINDOWS MAINTENANCE / ADMINISTRATOR" Foreground="#9DBAE2" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,10" /><TextBlock x:Name="DescriptionText" Foreground="#B2C2DB" FontSize="13" TextWrapping="Wrap" /></StackPanel>
    <Border Grid.Row="1" Background="#3B3426" CornerRadius="9" Padding="16" Margin="0,20,0,15"><TextBlock x:Name="ImpactText" Foreground="#FFE0A9" TextWrapping="Wrap" FontSize="12" /></Border>
    <TextBlock Grid.Row="2" Text="WINDOWS COMMAND OUTPUT" Foreground="#9DBAE2" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10" />
    <TextBox Grid.Row="3" x:Name="OutputBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#0B1321" Foreground="#C4D8F5" BorderBrush="#31425B" Padding="14" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" />
    <Grid Grid.Row="4" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready for review. No command has started." Foreground="#B2C2DB" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0" /><Button x:Name="CopyButton" Grid.Column="1" Content="Copy output" Click="Copy_Click" Padding="15,10" Margin="0,0,10,0" /><Button x:Name="RunButton" Grid.Column="2" Content="Run this operation" Click="Run_Click" Padding="20,10" Background="#75A9FF" Foreground="#101C30" FontWeight="SemiBold" /></Grid>
  </Grid>
</Window>
